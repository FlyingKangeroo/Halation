{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: command line, dialogs and file access for the Lightroom round trip.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "cli:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$TEMP/**" },
        { "path": "$HOME/**" },
        { "path": "$PICTURE/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "/Volumes/**" },
        { "path": "/Users/**" },
        { "path": "C:\\**" },
        { "path": "D:\\**" }
      ]
    }
  ]
}
